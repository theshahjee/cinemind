# PostgreSQL (pgvector image from docker-compose.yml)
DATABASE_URL=postgres://cinemind:cinemind@localhost:5432/cinemind

# Bearer token the web app uses to call the API. Generate with: openssl rand -hex 32
CINEMIND_API_TOKEN=change-me
# Password for the web UI (HTTP basic auth, any username). Leave empty only on a trusted network.
CINEMIND_WEB_PASSWORD=

# TMDB v4 "API Read Access Token": https://www.themoviedb.org/settings/api
# Optional, but without it titles only have the fields in your IMDb CSV (no posters, cast, plots).
TMDB_READ_TOKEN=

# ---- LLM (optional). Recommendations work without one; only "Ask" gets smarter. ----
# none | gemini | openai   (openai = any OpenAI-compatible server)
LLM_PROVIDER=none
LLM_MODEL=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI-compatible examples:
#   Ollama (local, free):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1
#   Groq:                  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:            LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=

# Embeddings must be 768-dimensional. Defaults: gemini-embedding-001 (Gemini) or nomic-embed-text (Ollama).
# Point embeddings at a different server than chat if you like, e.g. Groq for chat + local Ollama for embeddings.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---- Trakt (optional): connect your Trakt account and sync ratings + watchlist ----
# Create an app at https://trakt.tv/oauth/applications (redirect URI: urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_SYNC_HOURS=6

# ---- Remote MCP connector for Claude / ChatGPT (optional) ----
# The public HTTPS origin your tunnel or reverse proxy forwards to port 4200, e.g. https://cinemind.example.com
CINEMIND_MCP_PUBLIC_URL=
# What you type on the "Allow access" page when connecting. At least 12 characters.
CINEMIND_MCP_PASSWORD=
# Let Claude/ChatGPT rate titles and edit your watchlist. Read-only when false.
CINEMIND_MCP_ALLOW_WRITES=false
